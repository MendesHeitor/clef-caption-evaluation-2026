# Local paths for the native (non-Docker) setup. Copy to .env and adjust.
# '~' and '*' are expanded; each pattern must match exactly one path.
# The '*' absorbs the mount-point name of the data partition, which can change between boots.

# Folder holding the datasets (dev_caption/ = "standard", dev_caption_synth/ = "synth")
CLEF_DATASETS_DIR=/media/hmp/*/Users/hmp/D/imageclef_datasets

# Models, HF/NLTK caches, MedCAT pack (put the UMLS .zip in <here>/MedCAT/), precomputed embeddings
CLEF_ARTIFACTS_DIR=/media/hmp/*/Users/hmp/D/clef_artifacts

# ROCOv2 (--dataset rocov2). Required for that dataset, even if the folder is empty or
# missing (its parent must exist): the validation split is downloaded and unpacked into it.
CLEF_ROCOV2_DIR=/media/hmp/*/Users/hmp/D/imageclef_datasets/rocov2

# Python venvs; keep on an ext4 filesystem (default: <repo>/.venvs)
# CLEF_VENVS_DIR=~/clef-venvs
